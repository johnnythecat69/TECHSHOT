# Поиск Google Images через Serper
SERPER_API_KEY=

# Поиск Яндекс Картинок через Yandex AI Studio Search API
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Локальная генерация на вашем ПК через ComfyUI Bridge.
# Значения добавляются только в Vercel. Работники их не видят.
COMFY_BRIDGE_URL=https://your-generator.example.com
COMFY_BRIDGE_TOKEN=change-this-to-a-long-random-secret
